+    def _remember_live_card(self, chat_id: str, message_id: str, payload: dict[str, Any]) -> None:
+        """Track the newest streaming card per chat so the footer can be folded into it."""
+        if not chat_id or not message_id:
+            return
+        cache = getattr(self, "_live_stream_cards", None)
+        if not isinstance(cache, dict):
+            cache = {}
+            self._live_stream_cards = cache
+        cache[str(chat_id)] = {
+            "message_id": str(message_id),
+            "payload": dict(payload or {}),
+            "rendered_at": time.time(),
+            "final": bool((payload or {}).get("final")),
+        }
+        while len(cache) > 64:  # bounded: one card per chat, oldest chats evicted
+            cache.pop(next(iter(cache)), None)
