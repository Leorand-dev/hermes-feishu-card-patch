+    def _is_live_card_message(self, message_id: str) -> bool:
+        """True when ``message_id`` is one of this adapter's streaming cards."""
+        cache = getattr(self, "_live_stream_cards", None)
+        if not isinstance(cache, dict) or not message_id:
+            return False
+        return any(str(entry.get("message_id") or "") == str(message_id) for entry in cache.values())
