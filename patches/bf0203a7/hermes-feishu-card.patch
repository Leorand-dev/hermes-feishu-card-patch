+    # --- Streaming-card replies (openclaw-feishu-patch parity) ------------------------------
+    #
+    # When ``platforms.feishu.card_replies`` is on, the gateway stream consumer's first
+    # frame (``metadata.expect_edits=True``) is sent as one interactive card and every
+    # later frame patches that same card in place.  The card payload is carried in
+    # ``metadata["hermes_card_stream"]``; it holds the answer body, the compact status
+    # block (tool progress / narration), and the final runtime-footer note.  A non-
+    # streamed final response (``metadata.is_final_response``) is also rendered as a
+    # finished card so a turn keeps one tidy card even when streaming is unavailable.
+
+    def supports_card_streaming(
+        self, chat_id: Optional[str] = None, *, chat_type: Optional[str] = None,
+        metadata: Optional[dict[str, Any]] = None,
+    ) -> bool:
+        """Gateway stream-consumer probe: card transport available for this chat."""
+        return bool(getattr(self, "_card_replies", False)) and self._client is not None
+
+    def stream_is_message_for_chat(self, chat_id: str) -> bool:
+        """Card mode streams into ONE message: tool/segment boundaries must not split it."""
+        return bool(getattr(self, "_card_replies", False))
+
+    def _card_title_text(self) -> str:
+        from plugins.platforms.feishu.card_stream import DEFAULT_TITLE
+        return str(getattr(self, "_bot_name", "") or "").strip() or DEFAULT_TITLE
+
+    @staticmethod
+    def _card_stream_metadata_payload(metadata: Optional[dict[str, Any]]) -> Optional[dict[str, Any]]:
+        if not isinstance(metadata, dict):
+            return None
+        from plugins.platforms.feishu.card_stream import CARD_STREAM_METADATA_KEY
+        payload = metadata.get(CARD_STREAM_METADATA_KEY)
+        return payload if isinstance(payload, dict) else None
+
+    def _stream_card_payload(
+        self, content: str, metadata: Optional[dict[str, Any]], *, finalize: bool = False,
+    ) -> Optional[dict[str, Any]]:
+        """Card payload for this send/edit, or None to use the text/post transport."""
+        if not bool(getattr(self, "_card_replies", False)):
+            return None  # avoid the card_stream import on every send for non-card configs
+        from plugins.platforms.feishu import card_stream as _cs
+        payload = self._card_stream_metadata_payload(metadata)
+        if payload is not None:
+            if finalize and not payload.get("final"):
+                payload = {
+                    **payload,
+                    "final": True,
+                    "status": "",
+                    "body": payload.get("body") or str(content or ""),
+                }
+            return payload
+        if not isinstance(metadata, dict) or not metadata.get("is_final_response"):
+            return None
+        # Non-streamed final: one finished card instead of one or more text bubbles.
+        footer = str(metadata.get("runtime_footer") or "").strip()
+        body = str(content or "")
+        if footer and body.rstrip().endswith(footer):
+            body = body.rstrip()[: -len(footer)].rstrip()
+        # Never render raw MEDIA:<path> directives inside the card; the gateway delivers
+        # attachments separately (same rule as the streaming transport's display text).
+        try:
+            body = self.strip_media_directives_for_display(body)
+        except Exception:
+            pass
+        if len(body) > _cs.CARD_BODY_MAX_CHARS:
+            # Too long for one bounded card: use the chunked text/post transport instead
+            # (no silent truncation; the card budget is only for the streaming path,
+            # where the consumer sends the overflow as continuation messages).
+            logger.info("[Feishu] Final response exceeds the card body budget; sending as text")
+            return None
+        return {
+            "schema": _cs.CARD_SCHEMA_VERSION,
+            "title": self._card_title_text(),
+            "body": body,
+            "status": "",
+            "footer": footer,
+            "final": True,
+            "template": _cs.HEADER_TEMPLATE_FINAL,
+        }
+
+    async def _fold_final_into_live_card(
+        self, chat_id: str, content: str, metadata: Optional[dict[str, Any]],
+    ) -> Optional[SendResult]:
+        """Fold a normal-lane final fallback into the still-open streaming card.
+
+        Normally the stream consumer suppresses this send. When finalization failed (or
+        the turn failed before a final frame), the gateway falls back to the normal final
+        send; folding it into the existing card keeps ONE reply and turns a provider
+        failure into an error card instead of a loose text bubble + half-written card.
+        """
+        if not bool(getattr(self, "_card_replies", False)) or not self._client:
+            return None
+        from plugins.platforms.feishu import card_stream as _cs
+        if not isinstance(metadata, dict) or metadata.get(_cs.CARD_STREAM_METADATA_KEY):
+            return None
+        live = self._live_card_for(chat_id)
+        message_id = str((live or {}).get("message_id") or "")
+        payload = dict((live or {}).get("payload") or {})
+        if not message_id or not payload or bool(payload.get("final")):
+            return None
+        try:
+            body = self.strip_media_directives_for_display(str(content or ""))
+        except Exception:
