+    async def _send_stream_card(
+        self, chat_id: str, payload: dict[str, Any], reply_to: Optional[str],
+        metadata: Optional[dict[str, Any]],
+    ) -> Optional[SendResult]:
+        """Create the streaming card; None → caller falls back to text/post."""
+        card_json = self._build_stream_card_json(payload)
+        if card_json is None:
+            return None
+        try:
+            response = await self._feishu_send_with_retry(
+                chat_id=chat_id, msg_type="interactive", payload=card_json, reply_to=reply_to, metadata=metadata,
+            )
+        except Exception as exc:
+            logger.warning("[Feishu] Streaming-card send failed: %s", exc)
+            return None
+        result = self._finalize_send_result(response, "streaming card send failed")
+        if not result.success:
+            logger.warning("[Feishu] Streaming-card send rejected: %s", result.error)
+            from plugins.platforms.feishu import card_stream as _cs
+            _cs.record_card_event("card_send_failed", error=str(result.error or "")[:120])
+            return None
+        if result.message_id:
+            self._remember_live_card(chat_id, result.message_id, payload)
+            from plugins.platforms.feishu import card_stream as _cs
+            _cs.record_card_event("card_send_ok")
+        return result
+
+    async def _patch_stream_card(
+        self, chat_id: str, message_id: str, payload: dict[str, Any],
+        metadata: Optional[dict[str, Any]], *, finalize: bool = False,
+    ) -> Optional[SendResult]:
+        """Patch the live card; None → caller falls back to its text/post path.
+
+        Feishu's per-message update frequency limit (230020) is transient: retry with
+        exponential backoff instead of tearing the card transport down for the turn.
+        A definitive failure returns ``SendResult(success=False, ...)`` so the consumer
+        can see the reason (and retry/defer rather than blindly downgrade).
+        """
+        if not message_id:
+            return None
+        card_json = self._build_stream_card_json(payload)
+        if card_json is None:
+            return None
+        last_error = ""
+        last_response = None
+        attempts = 3
+        for attempt in (1, 2, 3):
+            try:
+                request = self._build_patch_message_request(
+                    message_id=message_id,
+                    request_body=self._build_patch_message_body(content=card_json),
+                )
+                response = await self._run_blocking(self._client.im.v1.message.patch, request)
+                last_response = response
+            except Exception as exc:
+                last_error = str(exc)
+                logger.warning("[Feishu] Streaming-card patch attempt %d raised: %s", attempt, exc)
+                if attempt < attempts:
+                    await asyncio.sleep(0.6 * attempt)
+                continue
+            if self._response_succeeded(response):
+                result = SendResult(success=True, message_id=message_id, raw_response=response)
+                self._remember_live_card(chat_id, message_id, payload)
+                from plugins.platforms.feishu import card_stream as _cs
+                _cs.record_card_event("card_patch_ok", final=bool(finalize))
+                return result
+            last_error = f"[{getattr(response, 'code', '?')}] {getattr(response, 'msg', 'patch failed')}"
+            limited = "230020" in last_error or "frequency limit" in last_error.lower() \
+                or "too frequently" in last_error.lower()
+            if limited:
+                logger.warning(
+                    "[Feishu] Streaming-card patch rate-limited (attempt %d/%d): %s",
+                    attempt, attempts, last_error,
+                )
+                from plugins.platforms.feishu import card_stream as _cs
+                _cs.record_card_event("card_patch_rate_limited", final=bool(finalize), attempt=attempt)
+                if attempt < attempts:
+                    await asyncio.sleep(1.2 * attempt)
+                continue
+            if attempt == 1:
+                await asyncio.sleep(0.4)
+        logger.warning("[Feishu] Streaming-card patch failed for %s: %s", message_id, last_error)
+        from plugins.platforms.feishu import card_stream as _cs
+        _cs.record_card_event("card_patch_failed", final=bool(finalize), error=str(last_error)[:120])
+        return SendResult(success=False, error=last_error, raw_response=last_response)
+
+    async def send_footer(
+        self, chat_id: str, footer: str, metadata: Optional[dict[str, Any]] = None, *,
+        reply_to: Optional[str] = None,
+    ) -> SendResult:
+        """Fold the runtime footer into the streaming card it belongs to.
+
+        Streaming hands the answer body over before the usage numbers are known, so the
+        gateway sends the footer afterwards.  Patching it into the live card's note keeps
+        the reply as ONE card; without a live card it is an ordinary trailing message.
+        """
+        footer = str(footer or "").strip()
+        if not footer:
+            return SendResult(success=True)
+        if getattr(self, "_cardkit_streaming", False):
+            ck_state = self._cardkit_state_for(chat_id)
+            if ck_state is not None:
+                payload = {**dict(ck_state.get("payload") or {}), "footer": footer, "final": True}
+                ok = await self._cardkit_full_update(ck_state, payload)
+                if ok:
+                    ck_state["payload"] = payload
+                    return SendResult(success=True, message_id=str(ck_state.get("message_id") or ""))
+                logger.warning("[Feishu] CardKit footer update failed; sending as text")
+        if self._client and bool(getattr(self, "_card_replies", False)):
+            live = self._live_card_for(chat_id)
+            message_id = str((live or {}).get("message_id") or "")
+            if live and message_id:
+                payload = {**dict(live.get("payload") or {})}
+                payload.update({"footer": footer, "final": True, "status": ""})
+                result = await self._patch_stream_card(
+                    chat_id, message_id, payload, metadata, finalize=True,
+                )
+                if result is not None and result.success:
+                    return result
+                logger.warning("[Feishu] Footer fold into streaming card failed; sending as text")
+        return await self.send(chat_id, footer, reply_to=reply_to, metadata=metadata)
